# ─── TensiMenu Backend — Environment Variables ───────────────────────────────
# Salin file ini ke .env dan isi dengan nilai yang sesuai.
# JANGAN commit file .env ke repository.

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Ambil dari: Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret
JWT_ALGORITHM=HS256

# ─── Aplikasi ─────────────────────────────────────────────────────────────────
APP_NAME=TensiMenu API
APP_VERSION=1.0.0
DEBUG=false

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Pisahkan dengan koma jika lebih dari satu origin
CORS_ORIGINS=http://localhost:3000,https://tensimenu.vercel.app

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100

# ─── Database Retry ───────────────────────────────────────────────────────────
DB_RETRY_ATTEMPTS=3
DB_RETRY_BASE_DELAY=1.0

# ─── ML Artifacts ─────────────────────────────────────────────────────────────
# Path relatif dari direktori backend/
ML_ARTIFACTS_PATH=ml/artifacts
